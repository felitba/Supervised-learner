{
  "name": "ej3_base",
  "seed": 42,
  "data_path": "data/more_digits.csv",
  "target_column": "label",
  "preprocessing": "normalize",
  "split_train": 0.7,
  "split_val": 0.3,
  "split_test": 0,
  "activation": "tanh",
  "beta": 1.0,
  "architecture": [784, 256, 64, 10],
  "cost_function": "categorical_cross_entropy",
  "optimizer": "adam",
  "eta": 0.001,
  "training_mode": "minibatch",
  "batch_size": 64,
  "epochs": 50,
  "epsilon": 0.0005,
  "metrics": ["accuracy", "f1"],
  "momentum_beta": 0.9
}
