{
  "name": "ej2_base",
  "seed": 42,
  "data_path": "data/digits.csv",
  "target_column": "label",
  "preprocessing": "normalize",
  "split_train": 1.0,
  "split_val": 0.0,
  "split_test": 0.0,
  "activation": "logistic",
  "beta": 1.0,
  "architecture": [784, 64, 32, 10],
  "cost_function": "mse",
  "optimizer": "adam",
  "eta": 0.001,
  "training_mode": "minibatch",
  "batch_size": 128,
  "epochs": 100,
  "epsilon": 0.01,
  "metrics": ["accuracy", "f1"]
}
