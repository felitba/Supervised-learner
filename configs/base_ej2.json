{
  "name": "ej2_base",
  "seed": 42,
  "data_path": "data/digits.csv",
  "target_column": "label",
  "preprocessing": "normalize",
  "split_train": 0.8,
  "split_val": 0.1,
  "split_test": 0.1,
  "activation": "tanh",
  "beta": 1.0,
  "architecture": [784, 64, 32, 10],
  "cost_function": "mse",
  "optimizer": "gradient_descent",
  "eta": 0.01,
  "training_mode": "minibatch",
  "batch_size": 32,
  "epochs": 200,
  "epsilon": 0.001,
  "metrics": ["accuracy"]
}